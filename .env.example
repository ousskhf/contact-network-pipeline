# Copy to .env and adjust. Real values stay out of git (.env is gitignored).

# Google Sheet sync (optional: skipped when the id or the key file is missing).
# The id is the long token in the Sheet's URL; share the Sheet with the service account as editor.
CNP_SHEET_ID=
CNP_SHEET_TAB=
CNP_GOOGLE_CREDENTIALS=data/google-service-account.json

# Input folder holding contacts.vcf / contacts.csv and downline_raw.json (fetched nightly by
# ingest.fetch_network; downline.json for fixtures). "fixtures" runs the pipeline on the bundled mock data.
CNP_DATA_DIR=fixtures

# The ambassador-network source system (optional: ingest.fetch_network is skipped against fixtures,
# and the DAG soft-fails without it so the rest of the refresh still runs). Never commit the real
# values; set them in .env only, or as Airflow Variables for the nightly job.
# CNP_NETWORK_API_BASE=
# CNP_NETWORK_EMAIL=
# CNP_NETWORK_PASSWORD=

# Outputs.
CNP_DB=data/cnp.duckdb
CNP_OUTREACH=data/outreach.duckdb
CNP_EXPORT=data/contact_tracker.csv

# Set by the Docker image; only change it to run the dashboard outside Docker.
# CNP_ECHARTS=/opt/echarts.min.js

# Airflow only: absolute host path of this project, used for the DAG's Docker bind mounts.
# CNP_HOST_PROJECT=/opt/contact-network-pipeline

# Optional: bind the web UIs to your Tailscale address instead of 127.0.0.1 (also used for the
# Homepage tile links). Set it in .env only; never commit the real address.
# TAILSCALE_IP=

# Optional: organisation written on the cards of the phone-contacts export (vCard ORG). Set it in .env only.
# ORG_NAME=
